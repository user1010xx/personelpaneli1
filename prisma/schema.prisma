generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum TrainingRecordType {
  EGITIM
  GERIBILDIRIM
}

enum SuggestionRequestType {
  TALEP
  ONERI
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  qualityScores      QualityScore[]
  trainingFeedbacks  TrainingFeedback[]
  callFeedbacks      CallFeedback[]
  activityLogs       ActivityLog[]
  suggestionRequests SuggestionRequest[]
  initiativeWorks    InitiativeWork[]
}

model SuggestionRequest {
  id           String                @id @default(cuid())
  type         SuggestionRequestType
  reporterName String
  subject      String
  content      String
  createdById  String?
  createdBy    User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([type])
  @@index([createdById])
  @@index([createdAt])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String
  userEmail   String
  userRole    Role
  action      String
  description String
  moduleKey   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([action])
}

model RateLimitEntry {
  key        String   @id
  hits       Int      @default(0)
  windowEnds DateTime

  @@index([windowEnds])
}

model QualityScore {
  id           String   @id @default(cuid())
  personelName String
  phone        String
  score        Float
  note         String?
  recordDate   DateTime
  createdById  String?
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([personelName, recordDate])
  @@index([recordDate])
}

model TrainingFeedback {
  id           String             @id @default(cuid())
  personelName String
  recordType   TrainingRecordType @default(EGITIM)
  recordDate   DateTime
  startTime    String
  endTime      String
  topic        String
  trainer      String
  createdById  String?
  createdBy    User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([personelName, recordDate])
  @@index([recordDate])
  @@index([recordType, recordDate])
}

model CallFeedback {
  id           String             @id @default(cuid())
  personelName String
  recordType   TrainingRecordType @default(GERIBILDIRIM)
  recordDate   DateTime
  startTime    String
  endTime      String
  topic        String
  trainer      String
  createdById  String?
  createdBy    User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([personelName, recordDate])
  @@index([recordDate])
  @@index([recordType, recordDate])
}

model InitiativeWork {
  id                  String   @id @default(cuid())
  personelName        String
  recordDate          DateTime
  callCount           Int
  talkDurationSeconds Int
  memberCount         Int
  createdById         String?
  createdBy           User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([personelName, recordDate])
  @@index([recordDate])
  @@index([createdById])
}
