# Railway Environment Variables
# Railway'de gerçek değerleri Variables ekranından girin.
# Bu dosya örnektir; gizli değer içermez.

# PostgreSQL (Railway PostgreSQL servisi otomatik sağlayabilir)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Güvenlik — üretimde openssl rand -base64 48 ile üretin
JWT_SECRET="CHANGE_ME_MIN_32_CHARS"

# Railway/env admin
# Deploy sırasında bu admin yoksa oluşturulur; varsa adı/rolü/aktifliği güncellenir.
# ADMIN_PASSWORD değişirse bu kullanıcının şifresi de güncellenir.
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# Opsiyonel
NODE_ENV="production"
PORT="3000"

# Telegram bot (opsiyonel)
# BotFather'dan alınan token. Boşsa bot kapalıdır.
TELEGRAM_BOT_TOKEN=""
# Bildirimlerin gideceği sohbet ID (kullanıcı veya grup). Komutlar da bu sohbetten kabul edilir.
TELEGRAM_CHAT_ID=""
# Ek yetkili sohbetler (virgülle). Boşsa yalnızca TELEGRAM_CHAT_ID kullanılır.
# TELEGRAM_ALLOWED_CHAT_IDS="123,456"
# Webhook için genel adres. Yoksa uygulama polling kullanır.
# PUBLIC_APP_URL="https://panel.example.com"
# TELEGRAM_WEBHOOK_SECRET=""
