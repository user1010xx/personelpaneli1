# Railway Environment Variables
# Railway'de gerçek değerleri Variables ekranından girin.
# Bu dosya örnektir; gizli değer içermez.

# PostgreSQL (Railway PostgreSQL servisi otomatik sağlayabilir)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Güvenlik — üretimde openssl rand -base64 48 ile üretin
JWT_SECRET="CHANGE_ME_MIN_32_CHARS"

# Railway/env admin
# Deploy sırasında bu admin yoksa oluşturulur; varsa adı/rolü/aktifliği güncellenir.
# ADMIN_PASSWORD değişirse bu kullanıcının şifresi de güncellenir.
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# Google Service Account (Sheets okuma)
GOOGLE_SERVICE_ACCOUNT_EMAIL="service-account@example-project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----\n"

# Opsiyonel
NODE_ENV="production"
PORT="3000"

# Sheet/Excel satırları bu aydan eski olanları sync/upload sonrası temizler (varsayılan 12)
ARCHIVE_MONTHS="12"

# true ise satır ayrıştırmada yalnızca bilinen başlıklar kullanılır
STRICT_ROW_PARSING="true"
